+/** One session's actually-used model route, from its durable modelSelection projection. */
+type SessionModelRef = NonNullable<SessionProjectionMap['modelSelection']['lastUsed']>
+
+/**
+ * The route a session ran on: the last request header wins over pending intent.
+ * @param selection - the session's `modelSelection` projection value, when known.
+ * @returns the used route, or undefined before the session makes its first request.
+ */
+function usedModel(
+  selection: SessionProjectionMap['modelSelection'] | undefined,
+): SessionModelRef | undefined {
+  return selection?.lastUsed ?? selection?.next ?? undefined
+}
+
+/**
+ * Full route readout for a model tooltip, e.g. "openai/gpt-5.6-sol · high".
+ * @param readout - the resolved route plus its optional reasoning effort.
+ * @returns the provider-qualified route in one line.
+ */
+function modelRoute(readout: SessionModelRef): string {
+  return readout.reasoningEffort === undefined
+    ? `${readout.provider}/${readout.model}`
+    : `${readout.provider}/${readout.model} · ${readout.reasoningEffort}`
+}
